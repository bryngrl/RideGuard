+import { UnauthorizedException } from '@nestjs/common';
+import { FirebaseAuthGuard } from './firebase-auth.guard';
+
+describe('FirebaseAuthGuard security checks', () => {
+  function harness() {
+    const service = { verifyToken: jest.fn().mockResolvedValue({ uid: 'owner', email_verified: true }),
+      isDeletionScheduled: jest.fn().mockResolvedValue(false) };
+    const reflector = { getAllAndOverride: jest.fn().mockReturnValue(false) };
+    const request = { headers: { authorization: 'Bearer fixture-token' } };
+    const context = { getHandler: () => () => {}, getClass: () => class {},
+      switchToHttp: () => ({ getRequest: () => request }) };
+    return { service, context, guard: new FirebaseAuthGuard(service as never, reflector as never) };
+  }
+
+  it('requests revoked/disabled-token verification before protected access', async () => {
