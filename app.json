{
  "expo": {
    "name": "RideGuard",
    "slug": "RideGuard",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/official-logo.png",
    "scheme": "rideguard",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logos/official-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "icon": "./assets/images/logos/official-logo.png"
    },
    "android": {
      "package": "com.rideguard.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logos/official-logo.png",
        "monochromeImage": "./assets/images/logos/official-logo.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logos/official-logo.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9a4ebad-effb-4360-b2a0-556cc956ff63"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f9a4ebad-effb-4360-b2a0-556cc956ff63"
    }
  }
}
