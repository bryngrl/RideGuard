{
  "expo": {
    "name": "RideGuard",
    "slug": "RideGuard",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/logos/logo.png",

    "scheme": "rideguard",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/Logo/official-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "defaultChannel": "alerts",
          "icon": "./assets/images/logos/logo.png",
          "color": "#1A2B4C"
        }
      ]
    ],
    "ios": {
      "icon": "./assets/images/logos/logo.png"
    },
    "android": {
      "package": "com.rideguard.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",

        "foregroundImage": "./assets/images/logos/logo.png"
      }
    },
    "web": {
      "output": "static",

      "favicon": "./assets/images/logos/official-logo.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9a4ebad-effb-4360-b2a0-556cc956ff63"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f9a4ebad-effb-4360-b2a0-556cc956ff63"
    }
  }
}
